# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RENZIY_SEED_PASSWORD: Optional bootstrap password for freshly seeded accounts.
# If omitted, the server generates a one-time random seed password (printed to
# the server log on first boot).
RENZIY_SEED_PASSWORD=""

# RENZIY_ADMIN_EMAIL / RENZIY_ADMIN_PASSWORD: Owner login for the admin console.
# If RENZIY_ADMIN_PASSWORD is omitted, a random one is generated and printed
# to the server log on first boot. Set a real value before deploying.
RENZIY_ADMIN_EMAIL="admin@renziy.app"
RENZIY_ADMIN_PASSWORD=""

# RENZIY_SESSION_SECRET / RENZIY_PASSWORD_PEPPER: required in production.
# The server refuses to start in production without these set - it will NOT
# fall back to a value checked into this repo. In development, if omitted,
# a random value is generated once and cached in .renziy-data/.dev-secrets.json
# (gitignored) so sessions and password hashes survive a dev server restart.
# Generate real values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENZIY_SESSION_SECRET=""
RENZIY_PASSWORD_PEPPER=""

# POSTGRES_URL: required always (dev and prod). Connection string for your
# Vercel Postgres (Neon) database - a server-only credential, never send it to
# the browser or prefix it with VITE_. If the project is linked to a Vercel
# Postgres database, run `vercel env pull .env.local` to fetch it, or copy it
# from the Vercel dashboard -> Storage -> your database -> .env.local tab.
# Run db/schema.sql once against the database (via the dashboard's Query tab,
# or `psql "$POSTGRES_URL" -f db/schema.sql`) before starting the server.
POSTGRES_URL=""

# RESEND_API_KEY: optional. Get one at resend.com -> API Keys. If omitted,
# password reset codes just get console.log'd instead of emailed (fine for
# local dev). Set it in production so reset codes actually reach users.
RESEND_API_KEY=""

# RESET_EMAIL_FROM: the "from" address reset emails are sent from. Defaults
# to Resend's shared test address, which works immediately with any API key
# but only for accounts/senders Resend allows for testing. Once you verify
# your own domain in Resend, switch this to e.g. "Renziy <no-reply@renziy.app>".
RESET_EMAIL_FROM="Renziy <onboarding@resend.dev>"
